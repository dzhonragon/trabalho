# Copie este arquivo para .env e gere um segredo aleatório antes de executar.
# Exemplo de geração: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
# Mantenha 0 no desenvolvimento local HTTP. Use 1 somente com HTTPS em produção.
COOKIE_SECURE=0
